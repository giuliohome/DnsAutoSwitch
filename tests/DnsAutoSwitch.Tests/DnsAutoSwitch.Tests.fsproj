<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows only: the permission tests use the Windows ACL APIs. Not part of DnsAutoSwitch.slnx, so
       "dotnet build" and "dotnet publish" in the repository root still see the service alone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TempFolder.fs" />
    <Compile Include="SecurityTests.fs" />
    <Compile Include="ConfigTests.fs" />
    <Compile Include="HoldTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DnsAutoSwitch.fsproj" />
  </ItemGroup>

</Project>
